  "cards": [
    {
      "dot": "emerald",
      "title": "统一接单原则",
      "items": [
        "小程序与微信群最终进入同一办公室公共待办，但来源、原始证据和外部提交号始终分开",
        "任何渠道都先形成订单草稿；办公室 A/B 复核后，正式订单命令才可执行一次"
      ]
    },
    {
      "dot": "rose",
      "title": "服务端权威",
      "items": [
        "客户身份、字段权限、幂等键、请求哈希、价格、库存、交期和文件归属由服务端判定",
        "客户端报价与库存只作为客户当时所见快照，不可直接成为正式成交事实"
      ]
    },
    {
      "dot": "cyan",
      "title": "客户可见投影",
      "items": [
        "BFF 只返回当前客户自己的目录、订单和简化状态，不暴露库位、成本、机台、内部待办或审计",
        "公开状态由 ERP 内部节点映射生成，不要求客户理解工厂内部流程"
      ]
    },
    {
      "dot": "amber",
      "title": "上线边界",
      "items": [
        "该架构不阻塞原材料一期的本地现场试跑；小程序客户测试属于后续独立上线范围",
        "正式开放前仍需企业云、域名与备案、HTTPS、PostgreSQL、对象存储和微信生产配置"
      ]
    }
  ]

# systemd only reads non-secret process wiring from this file.
# Keep real database, object-storage, auth, print and CUPS values in the audited
# /etc/erp/erp.production.env file with owner erp:erp and mode 0600.
ERP_V1_PRODUCTION_ENV_FILE=/etc/erp/erp.production.env
# Status/evidence artifacts are release-independent operational data. Keep them
# outside /opt/erp/current so a controlled release switch cannot hide or erase
# the latest go-live pack.
ERP_V1_GO_LIVE_ARTIFACT_ROOT=/var/lib/erp/v1-go-live-artifacts
ERP_API_PORT=8787
ERP_API_SHUTDOWN_TIMEOUT_MS=25000
# 真实考勤只经受控 HTTPS 网关进入 ERP；令牌放入 0600 的生产环境文件，禁止写入本文件。
# ERP_ATTENDANCE_PROVIDER_MODE=http_json
# ERP_ATTENDANCE_PROVIDER_KEY=deli
# ERP_ATTENDANCE_PROVIDER_ENDPOINT=https://attendance-gateway.example.com/v1/punches/query
# ERP_ATTENDANCE_PROVIDER_TIMEOUT_MS=10000
# 每次部署由受控发布锁写入；四项必须与服务器当前完整提交一致。
ERP_RELEASE_TARGET=tencent-production
ERP_RELEASE_COMMIT=<REPLACE_WITH_FULL_40_CHARACTER_RELEASE_COMMIT>
ERP_RELEASE_VERSION=<REPLACE_WITH_CONTROLLED_RELEASE_VERSION>
ERP_RELEASE_LOCK_DIGEST=<REPLACE_WITH_64_CHARACTER_RELEASE_LOCK_DIGEST>
ERP_RELEASE_BUILT_AT=<REPLACE_WITH_ISO_8601_BUILD_TIME>
# 整套 ERP 保持部署，首发阶段仅允许原材料业务白名单写入。
ERP_FIRST_RELEASE_SCOPE=raw_material
# Miniapp integration workers load secrets and endpoints from the same audited
# production env file; these values only bound polling and health behavior.
ERP_PRICE_RELEASE_WORKER_POLL_MS=2000
ERP_PRICE_RELEASE_WORKER_BATCH_SIZE=4
ERP_PRICE_RELEASE_WORKER_MAX_ATTEMPTS=10
MINIAPP_ARTWORK_WORKER_POLL_MS=2000
MINIAPP_ARTWORK_WORKER_BATCH_SIZE=2
MINIAPP_ARTWORK_MAX_ATTEMPTS=8
ERP_MINIAPP_QUEUE_STALE_SECONDS=900
ERP_MINIAPP_HEALTH_REQUEST_TIMEOUT_MS=3000
BAGWIN_ERP_HEALTH_URL=http://127.0.0.1:8790/healthz
# The audited production env should set ERP_PRINT_COMMAND_BRIDGE_SPOOL_DIR=/var/spool/erp-print.
# Tencent OCR SecretId / SecretKey belong only in /etc/erp/erp.production.env (0600), never in this tracked systemd wiring file.

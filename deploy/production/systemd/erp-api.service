[Unit]
Description=ERP V1 API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=erp
Group=erp
WorkingDirectory=/opt/erp/current
Environment=NODE_ENV=production
Environment=ERP_RUNTIME_MODE=production
EnvironmentFile=/etc/erp/erp-service.env
ExecStartPre=/usr/bin/test -r /etc/erp/erp.production.env
ExecStart=/usr/bin/node server/apiServer.mjs --mode production
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/erp /var/spool/erp-print

[Install]
WantedBy=multi-user.target

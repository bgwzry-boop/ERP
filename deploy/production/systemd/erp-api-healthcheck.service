[Unit]
Description=ERP V1 API production health check
After=erp-api.service

[Service]
Type=oneshot
User=erp
Group=erp
WorkingDirectory=/opt/erp/current
ExecStart=/usr/bin/node scripts/run-v1-production-service-health-check.mjs --api-base-url http://127.0.0.1:8787/api --no-write
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
